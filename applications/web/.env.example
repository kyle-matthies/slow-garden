NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep off until the provider evaluation and activation receipt passes.
GARDEN_AI_ENABLED=false

# Keep off until the in-app deletion migration (20261116010931_in_app_deletion.sql)
# is applied to the database. Off hides every delete control and keeps the
# landing page's "deletion is not available yet" wording.
GARDEN_DELETION_ENABLED=false

# Build target. Leave unset for the hosted app. `GARDEN_STATIC_EXPORT=1 next build`
# writes a static export to out/ (no Next server; browser store; session in browser
# storage) and needs both Supabase values above at build time. Set it on the build
# command, not in a deployed environment. See
# documents/operations/STATIC_EXPORT_2026-11-16.md.
# GARDEN_STATIC_EXPORT=1
